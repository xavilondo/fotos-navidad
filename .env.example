# Copiad este archivo a .env.local para desarrollar. En Vercel, estas variables van en
# Settings → Environment Variables. Nunca pongáis claves reales en el repositorio.

# Postgres (Neon en producción, `aws-eu-central-1`). En local, cualquier Postgres 16+.
DATABASE_URL=postgres://usuario@localhost:5432/fotos_navidad

# URL pública de la app (enlaces de los emails y del .ics).
URL_APP=http://localhost:3000

# Resend (dominio verificado en eu-west-1). Sin clave, los emails se escriben en la consola.
RESEND_API_KEY=
EMAIL_REMITENTE="AFA Las Palmeras <fotos@afalaspalmeras.es>"
EMAIL_RESPONDER_A=
# Secreto del webhook de Resend (rebotes), con el formato whsec_…
RESEND_WEBHOOK_SECRET=

# Cloudflare Turnstile. Estas son las claves de prueba públicas de Cloudflare, que siempre pasan.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Secreto del cron de Vercel (/api/cron/outbox). Vercel lo envía como `Authorization: Bearer …`.
CRON_SECRET=cambiadme

# Clave secreta del AFA para el HMAC de compensación (fase 5). 32 bytes en base64.
CLAVE_COMPENSACION=

# Solo para las pruebas: un Postgres de usar y tirar para el test de concurrencia (se borra entero).
# DATABASE_URL_TEST=postgres://usuario@localhost:5432/fotos_navidad_test

# Enlace público al código del reparto (el repositorio del AFA), para la página /sorteo.
URL_REPOSITORIO=https://github.com/xavilondo/fotos-navidad/tree/main/src/dominio/reparto

# Datos del AFA para los textos de privacidad (son públicos).
NEXT_PUBLIC_AFA_NIF=
NEXT_PUBLIC_AFA_EMAIL=

# Envíos de inscripción por conexión y hora (30 por defecto; el spec decía 5, pero en la apertura muchas
# familias comparten IP, p. ej. por el CGNAT de los operadores móviles).
# LIMITE_ALTAS_POR_HORA=30
