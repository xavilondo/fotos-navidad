# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env: solo se versiona el ejemplo
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/

# túnel de los prototipos
/.scratch/fotos-navidad/tunel/*.pid
/.scratch/fotos-navidad/tunel/*.log
/.scratch/fotos-navidad/tunel/url.txt

# copias de la base de datos (nunca al repositorio)
*.dump
*.sql.gz
*.gpg

# copias de seguridad
/copias/

# vistas previas generadas
/.scratch/emails-vista-previa/
/.scratch/agenda-ejemplo.pdf

# material del AFA con fotos de peques: nunca al repositorio público
/dossier/

# simulaciones con la instantánea de inscripciones actuales: solo local
/.scratch/fotos-navidad/simulacion-local/
