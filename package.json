{
  "name": "fotos-navidad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inscripción y reparto justo de horas para las fotos de Navidad del AFA CEI Las Palmeras",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "tsx scripts/migrar.ts",
    "edicion:cargar": "tsx scripts/edicion-cargar.ts",
    "emails:vista-previa": "tsx scripts/emails-vista-previa.ts",
    "reparto:verificar": "tsx scripts/reparto-verificar.ts",
    "edicion:ensayo": "tsx scripts/edicion-ensayo.ts",
    "admin:crear": "tsx scripts/admin-crear.ts",
    "semilla:familias": "tsx scripts/semilla-familias.ts",
    "copia:cifrada": "bash scripts/copia-cifrada.sh"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@node-rs/argon2": "2.2.2",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@vercel/functions": "3.10.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.56.0",
    "motion": "14.2.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "server-only": "0.0.1",
    "shadcn": "4.21.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.33.0"
}
